menu "LoRa Mesh Gateway"
    config LMESH_RADIO_WIO
        bool "Radio: Seeed Wio-E5 (LoRa star network) instead of Ebyte E52 (mesh)"
        default n
        help
            Build the radio driver shared/wio.c instead of shared/e52.c. The
            Wio-E5 runs its factory AT firmware in test mode as a plain LoRa
            radio; addressing, acknowledgements and retries are done by wio.c.
            Build a separate configuration for it, see sdkconfig.wio.defaults.
    config LMGW_E52_USB
        bool "Radio board on USB-HS (OTG) port: E52 via CH340, Wio-E5 via CP2102N or CH340 (else UART pins)"
        default y
    config LMGW_E52_UART_NUM
        int "UART port for E52"
        default 1
    config LMGW_E52_TX_GPIO
        int "ESP TX -> E52 RXD (pin 10) GPIO"
        default 17
    config LMGW_E52_RX_GPIO
        int "ESP RX <- E52 TXD (pin 9) GPIO"
        default 18
    config LMGW_E52_RST_GPIO
        int "E52 NRST (pin 17) GPIO, -1 = not wired"
        default -1
    config LMGW_E52_BAUD
        int "E52 UART baud"
        default 115200
endmenu
